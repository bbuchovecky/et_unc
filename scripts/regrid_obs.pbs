#!/bin/bash
#PBS -N regrid_obs
#PBS -A UWAS0155
#PBS -q casper
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -j oe

# DEPRECATED: the obs pipelines regrid in memory with etunc.load.obs.load_obs_regridded
# and no longer read the files this job writes. Kept until that path is verified.

REPO_DIR="/glade/u/home/bbuchovecky/projects/et_unc"

set -euo pipefail

export OMP_NUM_THREADS="${PBS_NCPUS:-4}"

cd "${REPO_DIR}"

echo "Job ${PBS_JOBID} started on $(hostname) at $(date)"
echo "OMP_NUM_THREADS=${OMP_NUM_THREADS}"

# Use the -u flag to run the script with unbuffered output
/glade/work/bbuchovecky/miniforge3/envs/etunc/bin/python3 -u scripts/regrid_obs.py

echo "Job ${PBS_JOBID} finished at $(date)"
