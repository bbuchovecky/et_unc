#!/bin/bash
#PBS -N run_all
#PBS -A UWAS0155
#PBS -q casper
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=8:mem=128GB
#PBS -j oe
#PBS -o /glade/work/bbuchovecky/et_unc/logs/

# The whole pipeline (scripts/run_all.sh) as one Casper job. Each step's full log
# (with git header) is also saved to WORK_ROOT/logs by scripts/run_logged.sh.
#
# Usage (settings as in scripts/run_all.sh, passed with -v; several run files in one
# quoted RUNS, separated by spaces):
#   qsub scripts/run_all.pbs                                   # defaults of config/pipeline.yml
#   qsub -v RUNS=config/runs/aw_bins20.yml scripts/run_all.pbs
#   qsub -v SKIP_PREP=1,RUNS=config/runs/bins10.yml scripts/run_all.pbs
#   qsub -v RUNS="config/runs/bins10.yml config/runs/aw_bins10.yml" scripts/run_all.pbs
# Resources are overridden on the command line, e.g. -l walltime=12:00:00
#
# Jobs running at the same time must not both run the prep scripts of one PREP_ID (they
# write the same inputs files): list the runs in one job's RUNS (the prep runs once per
# PREP_ID), or start the others with SKIP_PREP=1 after the prep is done.

REPO_DIR="/glade/u/home/bbuchovecky/projects/et_unc"

set -euo pipefail

export OMP_NUM_THREADS="${PBS_NCPUS:-8}"

cd "${REPO_DIR}"

echo "Job ${PBS_JOBID} (scripts/run_all.sh) started on $(hostname) at $(date)"
echo "OMP_NUM_THREADS=${OMP_NUM_THREADS}"

scripts/run_all.sh

echo "Job ${PBS_JOBID} finished at $(date)"
