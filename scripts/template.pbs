#!/bin/bash
#PBS -N template
#PBS -A <account>
#PBS -q casper
#PBS -l walltime=1:00:00
#PBS -l select=1:ncpus=8:mem=96GB
#PBS -j oe
#PBS -o <log_dir>

# Usage:
#   qsub scripts/template.pbs
# Resources are overridden on the command line, e.g. -l walltime=02:00:00

REPO_DIR="<path-to-et_unc-repo>"

set -euo pipefail

script="scripts/<your-script>.py"

export OMP_NUM_THREADS="${PBS_NCPUS:-8}"

cd "${REPO_DIR}"

echo "Job ${PBS_JOBID} (${script}) started on $(hostname) at $(date)"
echo "OMP_NUM_THREADS=${OMP_NUM_THREADS}"

scripts/run_logged.sh "${script}"

echo "Job ${PBS_JOBID} finished at $(date)"