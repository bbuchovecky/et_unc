#!/bin/bash
#PBS -N prep
#PBS -A UWAS0155
#PBS -q casper
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=8:mem=128GB
#PBS -j oe
#PBS -o /glade/work/bbuchovecky/et_unc/logs/

# Steps 1-11 of docs/binning-workflow.md for one family: runs scripts/prep_<FAMILY>.py
# through scripts/run_logged.sh, so the full log (with git header) is also saved to
# WORK_ROOT/logs.
#
# Usage (FAMILY is obs, era5, cmip, lens, fppe or ippe):
#   qsub -N prep_obs -v FAMILY=obs scripts/prep.pbs
#   for f in obs era5 cmip lens fppe ippe; do qsub -N prep_$f -v FAMILY=$f scripts/prep.pbs; done
# Resources are overridden on the command line, e.g. -l walltime=04:00:00

REPO_DIR="/glade/u/home/bbuchovecky/projects/et_unc"

set -euo pipefail

script="scripts/prep_${FAMILY:?set FAMILY with qsub -v FAMILY=<obs|era5|cmip|lens|fppe|ippe>}.py"

export OMP_NUM_THREADS="${PBS_NCPUS:-8}"

cd "${REPO_DIR}"
if [[ ! -f "${script}" ]]; then
    echo "No such script: ${script} (FAMILY=${FAMILY})" >&2
    exit 2
fi

echo "Job ${PBS_JOBID} (${script}) started on $(hostname) at $(date)"
echo "OMP_NUM_THREADS=${OMP_NUM_THREADS}"

scripts/run_logged.sh "${script}"

echo "Job ${PBS_JOBID} finished at $(date)"
